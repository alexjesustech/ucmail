{
  "name": "ucmail",
  "displayName": "UCMail — Unread Category Mail",
  "version": "0.1.0",
  "description": "Gmail productivity extension: hide read mail in native tabs, batch unsubscribe, export to Markdown (PKM bridge).",
  "author": "Alex Jesus <alexjesus.tech@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.280",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "tailwindcss": "4.0.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "manifest": {
    "host_permissions": ["https://mail.google.com/*"],
    "permissions": ["storage", "downloads"]
  }
}
